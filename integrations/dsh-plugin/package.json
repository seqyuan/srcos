{
  "name": "@seqyuan/srcos-dsh",
  "version": "0.1.0",
  "description": "SRCOS as a dsh resource protocol: browse and preview an SRCOS gateway's home, workspaces and shared storages inside DeepSeek Harness",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "src/address.js",
    "src/api.js",
    "src/config.js",
    "src/provider.js",
    "src/client.js",
    "src/client.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": ["srcos", "dsh", "dsh-plugin", "deepseek-harness"],
  "license": "MIT",
  "private": false
}
