# Binaries
srcos
*.exe
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of go coverage
*.out

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# State/config (user-specific) — anchored to the repo root so that
# internal/config/ (source code) is not accidentally ignored.
/state.yaml
/config.yaml
# Everything under config/ is runtime state (session_secret, password_hash,
# agent tokens) and must not be committed — except the examples the docs tell
# you to copy. Without these negations the examples do not exist in a fresh
# clone, while README/AGENTS reference them.
/config/*
!/config/*.example.yaml
/data/

# The frontend bundle is a build product: only the .gitkeep that keeps the
# //go:embed directory present is committed, so a checkout builds without Node
# (the canvas page then explains how to build it).
internal/web/dist/*
!internal/web/dist/.gitkeep

# WeChat draft articles (公众号软文)
docs/公众号软文*

# Jupyter checkpoints
.ipynb_checkpoints/

# 前端工程依赖（webui/，见 Makefile 的 webui 目标）
webui/node_modules/
